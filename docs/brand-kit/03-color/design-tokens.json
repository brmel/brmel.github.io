{
  "$schema": "https://design-tokens.org/format/",
  "$description": "Ibraverse — Operating Protocol design tokens. W3C Design Tokens format. Theme via $extensions.theme (light|dark); category accents swap only color.accent.*.",
  "color": {
    "$type": "color",
    "paper":      { "$value": "#faf9f6", "$description": "Page background (light --bg)" },
    "paper-alt":  { "$value": "#f2f0e9", "$description": "Raised band/card (light --bg-alt)" },
    "ink":        { "$value": "#181715", "$description": "Primary text/titles · 17.0:1 on paper · AAA" },
    "ink-soft":   { "$value": "#4a4843", "$description": "Secondary text · 8.68:1 · AAA" },
    "ink-mute":   { "$value": "#8a877f", "$description": "Captions/meta ≥16px · 3.41:1 · large/UI only" },
    "rule":       { "$value": "#d9d6cb", "$description": "Hairlines (non-text)" },
    "dark": {
      "bg":       { "$value": "#14130f" },
      "bg-alt":   { "$value": "#1c1b16" },
      "ink":      { "$value": "#ece8dc", "$description": "15.2:1 on bg · AAA" },
      "ink-soft": { "$value": "#b8b3a2", "$description": "8.86:1 · AAA" },
      "ink-mute": { "$value": "#807c70", "$description": "4.46:1 · AA large" },
      "rule":     { "$value": "#2c2a23" }
    },
    "accent": {
      "$description": "One accent per asset, chosen by category. Master = restaurant. Each pair is [light, dark].",
      "restaurant":      { "$value": "#a8431a", "$extensions": { "dark": "#d97757", "soft": "#c96b3e", "soft-dark": "#e89878", "contrast-on-paper": "5.73:1 AA", "contrast-on-bg": "5.95:1 AA" } },
      "hike":            { "$value": "#3f6b3a", "$extensions": { "dark": "#5d8a52", "soft": "#5d8a52", "soft-dark": "#7aa86f", "contrast-on-paper": "5.91:1 AA", "contrast-on-bg": "4.62:1 AA" } },
      "spa":             { "$value": "#2f6b6b", "$extensions": { "dark": "#4f9a9a", "soft": "#4f9a9a", "soft-dark": "#6fb6b6", "contrast-on-paper": "5.80:1 AA", "contrast-on-bg": "5.68:1 AA" } },
      "event":           { "$value": "#6b3a5d", "$extensions": { "dark": "#9a5d86", "soft": "#9a5d86", "soft-dark": "#b87da6", "contrast-on-paper": "8.35:1 AAA", "contrast-on-bg": "3.79:1 (AA large/UI only — underline links on dark)" } },
      "city":            { "$value": "#3a5a6b", "$extensions": { "dark": "#5d86a0", "soft": "#5d86a0", "soft-dark": "#7da6c0", "contrast-on-paper": "6.99:1 AA", "contrast-on-bg": "4.76:1 AA" } }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Instrument Serif", "Georgia", "serif"] },
    "body":    { "$value": ["Inter Tight", "system-ui", "sans-serif"] },
    "mono":    { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }
  },
  "fontSize": {
    "$type": "dimension",
    "display-xl": { "$value": "5.5rem",   "$extensions": { "px": 88, "lh": 0.98, "tracking": "-0.02em", "font": "display" } },
    "display-l":  { "$value": "4rem",     "$extensions": { "px": 64, "lh": 1.0,  "tracking": "-0.015em", "font": "display" } },
    "display-m":  { "$value": "3rem",     "$extensions": { "px": 48, "lh": 1.04, "tracking": "-0.01em", "font": "display" } },
    "display-s":  { "$value": "2.125rem", "$extensions": { "px": 34, "lh": 1.08, "font": "display" } },
    "heading":    { "$value": "1.5rem",   "$extensions": { "px": 24, "lh": 1.25, "weight": 600, "font": "body" } },
    "subhead":    { "$value": "1.25rem",  "$extensions": { "px": 20, "lh": 1.4,  "weight": 500, "font": "body" } },
    "body-l":     { "$value": "1.125rem", "$extensions": { "px": 18, "lh": 1.62, "font": "body" } },
    "body":       { "$value": "1rem",     "$extensions": { "px": 16, "lh": 1.6,  "font": "body" } },
    "caption":    { "$value": "0.8125rem","$extensions": { "px": 13, "lh": 1.45, "font": "body" } },
    "eyebrow":    { "$value": "0.75rem",  "$extensions": { "px": 12, "lh": 1.3,  "weight": 500, "tracking": "0.12em", "case": "uppercase", "font": "mono" } },
    "data":       { "$value": "0.8125rem","$extensions": { "px": 13, "lh": 1.4,  "tracking": "0.04em", "font": "mono" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "24px" }, "6": { "$value": "32px" },
    "7": { "$value": "48px" }, "8": { "$value": "64px" }, "9": { "$value": "96px" }, "10": { "$value": "128px" }
  },
  "container": {
    "$type": "dimension",
    "text":    { "$value": "720px" }, "content": { "$value": "960px" },
    "wide":    { "$value": "1200px" }, "full":   { "$value": "1440px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" }, "sm": { "$value": "8px" }, "md": { "$value": "14px", "$description": "the photo frame" },
    "lg": { "$value": "20px" }, "pill": { "$value": "999px" }
  },
  "border": {
    "hairline":      { "$type": "dimension", "$value": "1px" },
    "hairline-strong": { "$type": "dimension", "$value": "1.5px" },
    "category-bar":  { "$type": "dimension", "$value": "4px" }
  },
  "shadow": {
    "$type": "shadow",
    "card":  { "$value": [{ "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "rgba(24,23,21,.04)" }, { "offsetX": "0", "offsetY": "2px", "blur": "8px", "spread": "0", "color": "rgba(24,23,21,.06)" }] },
    "photo": { "$value": [{ "offsetX": "0", "offsetY": "2px", "blur": "8px", "spread": "0", "color": "rgba(24,23,21,.08)" }] },
    "pop":   { "$value": [{ "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "0", "color": "rgba(24,23,21,.10)" }, { "offsetX": "0", "offsetY": "12px", "blur": "32px", "spread": "0", "color": "rgba(24,23,21,.10)" }] }
  },
  "duration": {
    "$type": "duration",
    "1": { "$value": "120ms" }, "2": { "$value": "200ms" }, "3": { "$value": "320ms" }, "4": { "$value": "480ms" }, "5": { "$value": "640ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard":  { "$value": [0.2, 0, 0, 1] },
    "out":       { "$value": [0.16, 1, 0.3, 1] },
    "in-out":    { "$value": [0.65, 0, 0.35, 1] },
    "spring":    { "$value": [0.34, 1.36, 0.64, 1], "$description": "play-button only — one gentle overshoot" }
  }
}
