{{- $pages := partial "func/main-pages.html" . }}
{{- with site.GetPage "/resume" }}{{ $pages = $pages | append . }}{{ end }}
{{- $index := slice }}
{{- range $pages }}
{{- $index = $index | append (dict
      "title" (.Title | htmlUnescape)
      "description" (.Description | plainify | htmlUnescape)
      "section" (cond (ne .Section "") (site.GetPage .Section).Title "")
      "date" (cond .Date.IsZero "" (time.Format ":date_long" .Date))
      "url" .RelPermalink
      "content" (substr (.Plain | htmlUnescape) 0 2000)) }}
{{- end }}
{{- $index | jsonify -}}
